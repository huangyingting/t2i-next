# OpenAI-compatible author model
OPENAI_API_KEY=replace-with-your-api-key
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY_ENV=OPENAI_API_KEY
OPENAI_AUTH_MODE=bearer
OPENAI_STRUCTURED_OUTPUT_MODE=json_schema
OPENAI_TEMPERATURE=0.6
OPENAI_OUTPUT_TOKEN_LIMIT=16384
OPENAI_TIMEOUT_SECONDS=180
OPENAI_TRANSPORT_RETRIES=2

# Set only the reasoning control supported by the endpoint.
# OPENAI_REASONING_EFFORT=none
# OPENAI_THINKING_MODE=disabled

# Run policy is CLI-only: --concurrency 8 --theme-batch-size 5 --generation-retries 2

# Azure OpenAI example:
# AZURE_OPENAI_API_KEY=replace-with-your-azure-api-key
# OPENAI_BASE_URL=https://YOUR-RESOURCE-NAME.openai.azure.com/openai/v1/
# OPENAI_API_KEY_ENV=AZURE_OPENAI_API_KEY
# OPENAI_AUTH_MODE=api_key
# OPENAI_MODEL=your-deployment-name
